SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_ENGINE=postgresql
DB_NAME=lotengo_db
DB_USER=postgres
DB_PASSWORD=replace-with-database-password
DB_HOST=localhost
DB_PORT=5432

JWT_SECRET=replace-with-a-random-jwt-secret

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-account@gmail.com
EMAIL_HOST_PASSWORD=replace-with-a-google-app-password
DEFAULT_FROM_EMAIL=Lotengo <your-account@gmail.com>

# URL pública HTTPS usada en los enlaces de verificación y recuperación.
# Déjala vacía solo para pruebas locales; configúrala antes de enviar correos reales.
PUBLIC_BASE_URL=
