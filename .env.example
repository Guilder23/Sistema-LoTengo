DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL se activa con DB_ENGINE=postgresql. SQLite es la opción local predeterminada.
DB_ENGINE=postgresql
DB_NAME=lotengo
DB_USER=lotengo
DB_PASSWORD=replace-this-password
DB_HOST=localhost
DB_PORT=5432
